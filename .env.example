# Stellar Network Configuration ("testnet" | "mainnet")
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional endpoints and passphrases are network-specific. Changing the
# selected network above uses only that network's settings.
NEXT_PUBLIC_STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_TESTNET_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_TESTNET_EXPLORER_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_STELLAR_MAINNET_RPC_URL=https://soroban-rpc.mainnet.stellar.org
NEXT_PUBLIC_STELLAR_MAINNET_NETWORK_PASSPHRASE="Public Global Stellar Network ; July 2015"
NEXT_PUBLIC_STELLAR_MAINNET_EXPLORER_URL=https://stellar.expert/explorer/public

# Soroban Prediction Market Smart Contract ID
NEXT_PUBLIC_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_CONTRACT_PREDICTION_MARKET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Set this to the poll contract ID; it does not fall back to the market contract.
NEXT_PUBLIC_CONTRACT_POLL=

# Toggle mock data vs live Soroban smart contracts ("true" | "false")
NEXT_PUBLIC_USE_MOCK_DATA=true

# Public origin of the deployed site, used as metadataBase for OpenGraph/Twitter URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
